# Copy to .env (gitignored) and fill only what you run. Never commit keys.

# Shared verifier (every returned email)
ZEROBOUNCE_API_KEY=

# Clay Public API key, plus the functions W1 runs. The IDs (function:t_...) are specific to your workspace:
# find them in the Clay app or with `clay routines list` (docs/REPRODUCE.md, section B step 3).
CLAY_API_KEY=
CLAY_ROUTINE_ID_COMPANY=
CLAY_ROUTINE_ID_WATERFALL=
# Findymail-only function (find + verify), built in the Clay app
CLAY_ROUTINE_ID_SINGLE=
CLAY_ROUTINE_ID_LINKEDIN=
CLAY_ROUTINE_ID_PHONE_WATERFALL=
# Forager-only phone function (find + its validation), built in the Clay app
CLAY_ROUTINE_ID_PHONE_SINGLE=

# Provider B (adapter not published)
PROVIDER_B_API_KEY=

# Provider A uses its own CLI's browser login, no key here

# Phone checker (Twilio Lookup, line type): a Standard API key
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
